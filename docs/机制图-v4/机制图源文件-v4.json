 "cards": [
  {
   "dot": "cyan",
   "title": "立案庭路由：三选一判决",
   "items": [
    "① 普通问答类：不调用三审九方，当前模型直接回答",
    "② 模式 A（一审+二审）：先转一审承办，进入一审程序",
    "③ 模式 B（二审+三审）：先转二审承办，进入二审程序"
   ]
  },
  {
   "dot": "violet",
   "title": "九席矩阵（价格序：输入价升序）",
   "items": [
    "一审：承办 DeepSeek V4 Flash ｜ 对抗 混元 Hy3 ｜ 裁决 MiniMax M3",
    "二审：承办 豆包 2.1 Turbo ｜ 对抗 DeepSeek V4 Pro ｜ 裁决 Kimi K2.7 Code",
    "三审：承办 GLM-5.3 ｜ 对抗 Qwen3.8 Max ｜ 裁决 Kimi K3",
    "同审级同厂互斥；承办与对抗必须异模型（杜绝自审自纠）"
   ]
  },
  {
   "dot": "amber",
   "title": "伴行机制（机制包 12：模型更替）",
   "items": [
    "触发：T1 指定 / T2 评分——纵向连续 2 次低于同席位历史均值，或连续 3 次低于阈值 60",
    "横向：低于同审级他模评分（样本≥3）、自身历史≥2 且连续 2 次",
    "定位：价格初筛（审级区间互斥）→ 能力锚定（±0.5 去抖）",
    "新老模型真实任务并行评测 → 评分比对 → 决定是否更换；7 天冷却 + 互斥锁"
   ]
  },
  {
   "dot": "rose",
   "title": "流转纪律（防扯皮·硬规则）",
   "items": [
    "审计意见返还承办：无异议 → 修正落地；有异议 → 直接转裁决（禁止来回扯皮）",
    "裁决意见返还承办与审计：任一方不服 → 上诉下一审级，仅带背景+异议问题（禁止重发全套意见）",
    "上诉级：承办分析 → 审计反馈 → 仍异议 → 裁决 = 终局；商业决策 → 裁决整理问题 → 用户终判",
    "每席验收纪律：A–V 22 项 + S8 审计维度 + 红线清单（桥接自动注入）"
   ]
  },
  {
   "dot": "emerald",
   "title": "支撑层：工具·技能·台账",
   "items": [
    "流程嵌入技能：requirement-analysis / ponytail / code-review",
    "bridge_core：统一桥接（输出约束 / 错误模式注入 / 预算硬顶）",
    "errors-ledger：错误模式库（双控更新）；决策 + 成本双台账",
    "视觉三席：读图 / 生图 / 视频——工具席只采证据，不参与裁决"
   ]
  }
 ],
